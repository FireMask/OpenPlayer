[Unit]
Description=OpenPlayer Hardware Agent
After=openplayer.service
Wants=openplayer.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=openplayer
Group=openplayer
SupplementaryGroups=gpio
WorkingDirectory=/opt/openplayer/hardware-agent
Environment=GPIOZERO_PIN_FACTORY=lgpio
# lgpio crea archivos de notificación en LG_WD (por defecto el cwd, de solo lectura con ProtectSystem=strict).
Environment=LG_WD=/tmp
ExecStart=/usr/bin/python3 /opt/openplayer/hardware-agent/main.py
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
# Sin ReadWritePaths=/run/openplayer: conectar a un socket no requiere escribir en el FS, y un bind mount
# fijaría el directorio viejo cuando el Service se reinicia y systemd lo recrea.

[Install]
WantedBy=multi-user.target
